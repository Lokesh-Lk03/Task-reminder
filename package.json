{
  "name": "taskly",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,blue \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "node --watch backend/server.mjs",
    "dev:web": "npm run dev --workspace frontend -- --host 127.0.0.1",
    "build": "npm run build --workspace frontend",
    "start": "node backend/server.mjs",
    "preview": "npm run preview --workspace frontend -- --host 127.0.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
